# ⚠️ 這是範本檔，實際憑證請填在 Streamlit Cloud 的 Settings → Secrets
# 複製這個檔為 secrets.toml 時，記得不要推到 GitHub

# FinLab 憑證（三個都要，缺一不可）
# 產生方式：在本機執行
#   python -m finlab token --env
# 會印出下面這三個變數

FINLAB_REFRESH_TOKEN = "在此貼上你的 refresh token"
FINLAB_SESSION_ID   = "在此貼上你的 session id"
FINLAB_API_KEY      = "在此貼上你的 api key"
